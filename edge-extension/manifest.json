{
  "manifest_version": 3,
  "name": "Desktop AI · DeepSeek",
  "version": "0.1.6",
  "description": "让 Desktop AI 使用当前 Edge 用户配置中已登录的 DeepSeek 网页。",
  "key": "",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://chat.deepseek.com/*", "http://127.0.0.1/*"],
  "action": { "default_popup": "pair.html", "default_title": "Desktop AI" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*"],
    "js": ["content.js"]
  }]
}
